{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Savebeam",
  "version": "../package.json",
  "identifier": "com.coopsrc.matrix.savebeam",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Savebeam",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' tauri: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CoopSrc",
    "category": "Video",
    "shortDescription": "本地优先的视频下载工具",
    "longDescription": "Savebeam 在本机解析并下载用户提供的视频链接，支持任务管理和可选组件配置。应用不提供媒体托管或转发服务。",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1MkEyOENDMjQ3RTcyNTgKUldSWWNuNGt6Q2dxcFdQRHN6QXY0Q3h6Y2hDRi9UZHlzdURDS0cyOWUxbXNHUHorNmRmcW8rWjcK",
      "endpoints": ["https://github.com/coopsrc/savebeam/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
